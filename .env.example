AGENT_LLM_PROVIDER=heuristic   # heuristic (offline, deterministic) | openai
AGENT_LLM_MODEL=gpt-4o-mini
AGENT_LLM_FALLBACK_MODEL=      # used when the primary fails
AGENT_MAX_LOOPS=2              # max replan loops (self-reflection)
AGENT_MAX_RETRIEVAL_ATTEMPTS=2 # max query rewrites in the corrective-RAG subgraph
AGENT_MAX_STEPS=40             # graph steps per run
AGENT_MAX_TOKENS_PER_RUN=60000 # LLM tokens per run
AGENT_TENANT_DAILY_TOKENS=0    # 0 = unlimited
AGENT_RATE_LIMIT_PER_MIN=30
AGENT_REQUIRE_APPROVAL=true    # human-in-the-loop before running SQL
AGENT_FOUR_EYES=false          # requester cannot approve their own SQL
AGENT_CHECKPOINT_URL=memory    # memory | sqlite:///agent.db | postgresql://user:pw@host/db
AGENT_REDIS_URL=               # shared rate limits / budgets across replicas
AGENT_API_KEYS=dev-key:alice:tenant-a:user,dev-approver:bob:tenant-a:user|approver
AGENT_WEB_PROVIDER=stub        # stub | tavily
TAVILY_API_KEY=
AGENT_CORPUS_PATH=data/corpus   # dev only (in-memory index)
AGENT_LOG_JSON=false

# Retrieval stack comes from open-rag (RAG_* variables, see https://github.com/w4coder/open-rag/blob/main/.env.example).
# RAG_QDRANT_URL set => the agent searches the shared open-rag index (no local ingestion).
RAG_EMBEDDING_PROVIDER=fake
RAG_QDRANT_URL=
OPENAI_API_KEY=

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-rag
